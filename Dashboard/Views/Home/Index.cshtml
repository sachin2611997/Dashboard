        // ============================================================
        // SYSTEM4 CHANGE
        // ============================================================

        $("#system4Dropdown").on("change", function () 
        { 
            var center = $("#centerSelect").val(); 
            var system4 = $(this).val() || "";
            selectedCenter = center; 
            selectedSystem4 = system4; 
            selectedSystem2 = ""; 
            // Reset subsites 
            $("#System2Dropdown") .empty() .append('<option value="">All Subsites</option>'); 
            // If All Sites is selected, hide subsites 
            if (system4 === "") { $("#System2Dropdown").hide();
                var ages = $("#ageDropdown").val() || [];
                loadSiteDashboard(center, "", "", ages);
                return; 
            } 
            // Show the subsite dropdown
            $("#System2Dropdown").show(); 

            // Keep the selected age groups
            var ages = $("#ageDropdown").val() || [];

            // Load dashboard for selected site with age filter
            loadSiteDashboard(center, system4, "", ages);

            // Fetch subsites belonging to the selected site
            $.ajax({ url: '@Url.Action("GetSubSites", "Home")', 
                type: "GET",
                traditional: true, 
                data: { center: center, system4: system4 }, 
                success: 
                    function (subSites) 
                    {
                        console.log("Subsites received:", subSites); 
                        $("#System2Dropdown") .empty() .append('<option value="">All Subsites</option>'); 
                        $.each(subSites || [], function (i, subSite)
                        {
                            $("#System2Dropdown").append( $("<option></option>") .val(subSite) .text(subSite) ); 
                        });
                    },
                error: function (xhr) 
                { 
                    console.log
                        ( 
                        "GetSubSites error:",
                        xhr.status, 
                        xhr.responseText 
                        ); 
                } 
            }); 
        });


        // ============================================================
        // System2 CHANGE
        // ============================================================

        $("#System2Dropdown").on( "change", function ()
        {
            var center = $("#centerSelect").val();
            var system4 = $("#system4Dropdown").val() || "";
            var system2 = $(this).val() || "";
            selectedCenter = center;
            selectedSystem4 = system4;
            selectedSystem2 = system2;

            // Keep the selected age groups
            var ages = $("#ageDropdown").val() || [];

            // Load dashboard with center, site, subsite and age filters
            loadSiteDashboard(center, system4, system2, ages);
            }
        );

        // ============================================================
        // SIDEBAR
        // ============================================================

        $(function () {

            var $sidebar = $("#sidebar");
            var collapseTimer = null;


            // =========================================================
            // SIDEBAR OPEN
            // =========================================================

            function expandSidebar() {

                clearTimeout(collapseTimer);

                $sidebar.addClass("open");
                $("body").addClass("sb-open");

            }


            // =========================================================
            // SIDEBAR CLOSE
            // =========================================================

            function collapseSidebar() {

                collapseTimer = setTimeout(function () {

                    $sidebar.removeClass("open");
                    $("body").removeClass("sb-open");

                }, 120);

            }


            $sidebar
                .on("mouseenter", expandSidebar)
                .on("mouseleave", collapseSidebar);


            $sidebar.on("focusin", expandSidebar);


            $sidebar.on("focusout", function (e) {

                if (!$.contains(this, e.relatedTarget)) {

                    collapseSidebar();

                }

            });


            // =========================================================
            // LOAD SITES
            // =========================================================

            function loadSystem4Sites(center) {

                console.log("Loading sites for:", center);


                // Reset Sites
                $("#system4Dropdown")
                    .empty()
                    .append('<option value="">All Sites</option>');


                // Reset Subsites
                $("#System2Dropdown")
                    .empty()
                    .append('<option value="">All Subsites</option>')
                    .hide();


                $.ajax({

                    url: '@Url.Action("GetSystem4Sites", "Home")',

                    type: 'GET',

                    data: {
                        center: center
                    },

                    success: function (sites) {

                        console.log("Sites received:", sites);


                        $.each(sites, function (i, site) {

                            $("#system4Dropdown").append(

                                $('<option>')
                                    .val(site)
                                    .text(site)

                            );

                        });

                    },

                    error: function (xhr) {

                        console.log(
                            "GetSystem4Sites ERROR:",
                            xhr.status,
                            xhr.responseText
                        );

                    }

                });

            }


            // =========================================================
            // DASHBOARD MENU
            // =========================================================

            function showDashboardMenu() {

                console.log("Dashboard clicked");


                // Dashboard ACTIVE
                $("#dashboardNav").addClass("active");

                // Report INACTIVE
                $("#reportNav").removeClass("active");


                // Hide Registry
                $("#registrySection").hide();


                // Show Sites
                $("#sitesSection").show();


                // Show All Sites dropdown
                $("#system4Dropdown")
                    .closest(".center-box")
                    .show();


                // Subsite should initially be hidden
                $("#System2Dropdown")
                    .closest(".center-box")
                    .show();

                $("#System2Dropdown").hide();


                // Use ALL CENTERS
                $("#centerSelect").val("registry");


                selectedCenter = "registry";
                selectedSystem4 = "";
                selectedSystem2 = "";


                // Load Sites for Registry / All Centers
                loadSystem4Sites("registry");


                // Load All Centers dashboard
                loadSiteDashboard(
                    "registry",
                    "",
                    ""
                );


                // Header
                $("#centerPill").text("All Centers");

                $("#center-label").text("Registry");

                $("#brandSub").text(
                    "All Registry Centers ·"
                );

            }


            // =========================================================
            // REPORT MENU
            // =========================================================

            function showReportMenu() {

                console.log("Report clicked");


                // Report ACTIVE
                $("#reportNav").addClass("active");

                // Dashboard INACTIVE
                $("#dashboardNav").removeClass("active");


                // Show Registry
                $("#registrySection").show();


                // Show Sites
                $("#sitesSection").show();


                // Show Site dropdown
                $("#system4Dropdown")
                    .closest(".center-box")
                    .show();


                // Subsite initially hidden
                $("#System2Dropdown")
                    .closest(".center-box")
                    .show();

                $("#System2Dropdown").hide();


                // Default Registry
                $("#centerSelect").val("registry");


                selectedCenter = "registry";
                selectedSystem4 = "";
                selectedSystem2 = "";


                // Load Sites for Registry
                loadSystem4Sites("registry");


                // Load Registry dashboard
                loadSiteDashboard(
                    "registry",
                    "",
                    ""
                );


                // Header
                $("#centerPill").text("All Centers");

                $("#center-label").text("Registry");

                $("#brandSub").text(
                    "All Registry Centers ·"
                );

            }


            // =========================================================
            // DASHBOARD CLICK
            // =========================================================

            $("#dashboardNav").on("click", function () {

                showDashboardMenu();

            });


            // =========================================================
            // REPORT CLICK
            // =========================================================

            $("#reportNav").on("click", function () {

                showReportMenu();

            });


            // =========================================================
            // THEME
            // =========================================================

            $("#themeBtn").on("click", function () {

                var current =
                    document.documentElement.getAttribute("data-theme");

                var next =
                    current === "dark"
                        ? "light"
                        : "dark";


                document.documentElement.setAttribute(
                    "data-theme",
                    next
                );


                try {

                    localStorage.setItem(
                        "hbcr-theme",
                        next
                    );

                }
                catch (e) { }

            });


            // =========================================================
            // LOAD SAVED THEME
            // =========================================================

            try {

                var savedTheme =
                    localStorage.getItem("hbcr-theme");


                if (savedTheme) {

                    document.documentElement.setAttribute(
                        "data-theme",
                        savedTheme
                    );

                }

            }
            catch (e) { }


        });



       
        // ============================================================
        // PAGE READY
        // ============================================================

        $(document).ready( function ()
        {


            // =====================================================
            // STARTING PAGE = DASHBOARD
            // =====================================================

            $("#dashboardNav").addClass("active");
            $("#reportNav").removeClass("active");


            // Registry hidden
            $("#registrySection").hide();


            // Sites visible because Dashboard is selected
            $("#sitesSection").show();


            // All Sites visible
            $("#system4Dropdown")
                .closest(".center-box")
                .show();


            // All Subsites initially hidden
            $("#System2Dropdown")
                .closest(".center-box")
                .show();

            $("#System2Dropdown").hide();


            // Initialize Age Category Select2 only once
            if (!$("#ageDropdown").hasClass("select2-hidden-accessible")) {

                $("#ageDropdown").select2({
                    placeholder: "Select Age Categories",
                    width: "100%",
                    closeOnSelect: false,
                    allowClear: true
                });

            }

            console.log(
                "Age dropdown initialized:",
                $("#ageDropdown").hasClass("select2-hidden-accessible")
            );

            console.log("Dashboard initializing...");

                // =====================================================
                // METRONIC
                // =====================================================

                if (
                    typeof Metronic !==  "undefined"
                ) {

                    Metronic.init();

                }


                if (
                    typeof Layout !== "undefined"
                ) {

                    Layout.init();

                }

                // =====================================================
                // CREATE AMCHARTS
                // =====================================================

                createClinicalChart();

                createAgeChart();

                createTTIChart();

                createTreatmentPieChart();


                // =====================================================
                // DEFAULT CENTER
                // =====================================================

                $("#centerSelect") .val("registry");


                $("#centerPill") .text("All Centers");


                $("#center-label") .text("Registry");


                $("#brandSub") .text("All Registry Centers · " );


                // =====================================================
                // DEFAULT COUNTS
                // =====================================================

                $("#statTotal").text( Number( centerCounts.registry.total ).toLocaleString()  );


                $("#statMale")
                    .text(
                        Number(centerCounts.registry.male ).toLocaleString()
                    );


                $("#statFemale")
                    .text(
                        Number( centerCounts.registry.female).toLocaleString()
                    );



                // LOAD DEFAULT CHARTS

                updateCenterChart( "registry" );

            // LOAD SITE DROPDOWN ON FIRST PAGE LOAD

                $("#centerSelect").val("registry").trigger("change");
                console.log( "Clinical chart:",clinicalChart);

                console.log(  "Age chart:", ageChart );

                console.log( "TTI chart:",ttiChart);

                console.log( "Dashboard initialized successfully" );

            }
        );

     
    </script>

</body>

