        // ============================================================
        // UPDATE CENTER CHARTS
        // ============================================================

        function updateCenterChart(center) {

            var clinicalData = [];

            var ageData = [];

            var treatmentData = [];

            var ttiData = [];

            if (center === "registry") {

                clinicalData =  allData || [];

                ageData = allAgeData || [];

                treatmentData = allObjData || [];

                ttiData =   alltti || [];

            }

            else if (center === "mumbai") {

                clinicalData = mumbaiData || [];

                ageData =  mumbaiAgeData || [];

                treatmentData = mumbaiObjData || [];

                ttiData =  mumbaitti || [];

            }

            else if (center === "vizag") {

                clinicalData = vizagData || [];

                ageData =  vizagAgeData || [];

                treatmentData = vizagObjData || [];

                ttiData =  vizagtti || [];

            }


            // CLINICAL

            if (clinicalChart) {

                clinicalChart.dataProvider =clinicalData;

                clinicalChart.validateData();

            }

            // AGE

            if (ageChart) {

                ageChart.dataProvider =   ageData;

                ageChart.validateData();

            }

            // TTI

            if (ttiChart) {

                ttiChart.dataProvider = ttiData;

                ttiChart.validateData();

            }

            // TREATMENT PIE

            if (treatmentPieChart) {

                treatmentPieChart.data = treatmentData;

                treatmentPieChart.invalidateRawData();

            }

        }

        // ============================================================
        // UPDATE TITLE
        // ============================================================

        function updateDashboardTitle(  center, system4, System2 )
        {

            var title =  "All Centers";


            if (center === "mumbai") {

                title =  "Mumbai";

            }

            else if (center === "vizag") {

                title =  "Vizag";

            }

            else if (center === "varanasi") {

                title = "Varanasi";

            }

            else if (center === "sangrur") {

                title =    "Sangrur";

            }

            if (system4 !== "") {

                title += " - " + system4;

            }

            if (System2 !== "") {

                title +=  " - " + System2;

            }

            $("#centerPill") .text(title);

        }


        // ============================================================
        // LOAD SITE DASHBOARD
        // ============================================================

      
var dashboardRequest = null;

function loadSiteDashboard(center, system4, System2,ages) {

   // console.log("Loading:", center, system4, System2);
    ages = ages || [];
    // Cancel the previous request if it is still running
    if (dashboardRequest !== null) {
        dashboardRequest.abort();
    }

    $("#centerPill").text("Loading...");

    dashboardRequest = 
        $.ajax({
        url: '@Url.Action("GetSiteDashboardData", "Home")',
            type: "GET",
            traditional: true,
        data: {
            center: center,
            system4: system4,
            System2: System2,
            ages: ages
        },
        traditional: true,

        success: function (data) {

            $("#statTotal").text(
                Number(data.total || 0).toLocaleString()
            );

            $("#statMale").text(
                Number(data.male || 0).toLocaleString()
            );

            $("#statFemale").text(
                Number(data.female || 0).toLocaleString()
            );

            if (clinicalChart) {
                clinicalChart.dataProvider = data.clinicalData || [];
                clinicalChart.validateData();
            }

            if (ageChart) {
                ageChart.dataProvider = data.ageData || [];
                ageChart.validateData();
            }

            if (treatmentPieChart) {
                treatmentPieChart.data = data.treatmentData || [];
                treatmentPieChart.invalidateRawData();
            }

            if (ttiChart) {
                ttiChart.dataProvider = data.ttiData || [];
                ttiChart.validateData();
            }

            selectedCenter = center;
            selectedSystem4 = system4;
            selectedSystem2 = System2;

            updateDashboardTitle(center, system4, System2);
        },

        error: function (xhr, status) {
            if (status !== "abort") {
                console.log(
                    "Dashboard error:",
                    xhr.status,
                    xhr.responseText
                );
            }
        },

        complete: function () {
            dashboardRequest = null;
        }
    });
}



