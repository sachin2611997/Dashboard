    <script src="~/assets/core.js"></script>
    <style>
       
  
        #pageLoader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: #ffffff;
            z-index: 9999999;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .loading-logo {
            width: 280px;
            max-width: 70%;
            height: auto;

            animation: logoPulse 1.5s ease-in-out infinite;
        }

        @@keyframes logoPulse {
            0%, 100% {
                opacity: 0.6;
                transform: scale(0.97);
            }

            50% {
                opacity: 1;
                transform: scale(1);
            }
        }

        #pageLoader.hide {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s ease;
        }
    

   




        :root {
            --bg: #eef2f5;
            --surface: #ffffff;
            --surface-2: #f7f9fb;
            --ink: #16303f;
            --ink-2: #4a6472;
            --ink-3: #7f939e;
            --line: #dde5ea;
            --primary: #0f6e82;
            --primary-soft: #e2f0f2;
            --male: #2f6db4;
            --female: #b0407b;
            --green: #3e8e6e;
            --amber: #c9873b;
            --sidebar-w: 250px;
            --sidebar-collapsed: 65px;
            --radius: 14px;
            --shadow: 0 1px 2px rgba(22,48,63,.06), 0 6px 20px -8px rgba(22,48,63,.18);
            --ease: .35s cubic-bezier(.4,0,.2,1);
        }


        /* =========================================================
           DARK MODE
        ========================================================== */

        @@media (prefers-color-scheme: dark) {

            :root:not([data-theme="light"]) {
                --bg: #0e1a20;
                --surface: #15252e;
                --surface-2: #1a2d37;
                --ink: #e7eef1;
                --ink-2: #a8bcc6;
                --ink-3: #7d949f;
                --line: #263e49;
                --primary: #4fb3c4;
                --primary-soft: #1d3b43;
                --male: #6ba3e0;
                --female: #e08ab6;
                --shadow: 0 1px 2px rgba(0,0,0,.3), 0 6px 20px -8px rgba(0,0,0,.5);
            }
        }


        :root[data-theme="dark"] {
            --bg: #0e1a20;
            --surface: #15252e;
            --surface-2: #1a2d37;
            --ink: #e7eef1;
            --ink-2: #a8bcc6;
            --ink-3: #7d949f;
            --line: #263e49;
            --primary: #4fb3c4;
            --primary-soft: #1d3b43;
            --male: #6ba3e0;
            --female: #e08ab6;
            --shadow: 0 1px 2px rgba(0,0,0,.3), 0 6px 20px -8px rgba(0,0,0,.5);
        }


        * {
            box-sizing: border-box;
        }

       

        html,
        body {
            margin: 0;
            padding: 0;
        }


        body {
            background: var(--bg);
            color: var(--ink);
            font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.55;
            font-variant-numeric: tabular-nums;
            -webkit-font-smoothing: antialiased;
        }


        h1,
        h2,
        h3,
        h4 {
            margin: 0;
            font-weight: 600;
            letter-spacing: -.01em;
        }


        a {
            color: inherit;
            text-decoration: none;
        }


        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
            border-radius: 6px;
        }


        /* =========================================================
           TOPBAR
        ========================================================== */

        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 64px;
            z-index: 60;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 0 24px 0 calc(var(--sidebar-collapsed) + 24px);
            transition: padding var(--ease);
        }


        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }


       .brand-mark {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}


      .brand-text {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    white-space: nowrap;
}

.brand-text h1 {
    font-size: 20px;
    line-height: 1.2;
    margin: 0;
    color: #1e49ab;
    text-transform: uppercase;
}

.brand-text h4 {
    font-size: 16px;
    line-height: 1.2;
    margin: 4px 0 0 0;
    color: #c74646;
    text-transform: uppercase;
}


            .brand-text p {
                margin: 1px 0 0;
                font-size: 18px;
                color: var(--ink-3);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                 color:#c74646;
            }


        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .center-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary-soft);
            color: var(--primary);
            border-radius: 999px;
            padding: 7px 14px;
            font-weight: 600;
            font-size: 12.5px;
            white-space: nowrap;
        }


        .icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--ink-2);
            cursor: pointer;
            display: grid;
            place-items: center;
            transition: background .2s, color .2s;
            padding:0 0 0 0;
            min-width:0;
        }


            .icon-btn:hover {
                background: var(--surface-2);
                color: var(--primary);
            }

            /* Age Dropdown */
          
             /* Select2 v3 - Age dropdown */
#ageFilter .select2-container {
    width: 100% !important;
}

#ageFilter .select2-container-multi .select2-choices {
    min-height: 38px;
    padding: 4px 6px;
    border: 1px solid #ced4da;
    border-radius: 6px;
    background: #fff;
    box-sizing: border-box;
}

/* Selected age category */
#ageFilter .select2-container-multi .select2-choices .select2-search-choice {
    position: relative;
    padding: 5px 25px 5px 8px;
    margin: 3px 5px 3px 0;
    border: 1px solid #c7ddff;
    border-radius: 5px;
    background: #eaf2ff;
    color: #245ca6;
    box-shadow: none;
}

/* The × remove button */
#ageFilter .select2-container-multi .select2-search-choice-close {
    position: absolute;
    top: 5px;
    right: 6px;
    left: auto;
    display: block;
    width: 14px;
    height: 14px;
    background: none !important;
    text-decoration: none;
    cursor: pointer;
}

#ageFilter .select2-container-multi .select2-search-choice-close:after {
    content: "\00d7";
    position: absolute;
    top: -4px;
    left: 0;
    color: #245ca6;
    font-size: 19px;
    font-weight: bold;
    line-height: 18px;
}

#ageFilter .select2-container-multi .select2-search-choice-close:hover:after {
    color: #d32f2f;
}













        /* =========================================================
           SIDEBAR
        ========================================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-collapsed);
            background: var(--surface);
            border-right: 1px solid var(--line);
            z-index: 70;
            overflow: hidden;
            transition: width var(--ease);
            display: flex;
            flex-direction: column;
        }


            .sidebar.open {
                width: var(--sidebar-w);
                box-shadow: 8px 0 28px -18px rgba(22,48,63,.45);
            }


        .sb-head {
            height: 64px;
            flex: none;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0 20px;
            border-bottom: 1px solid var(--line);
        }


        .sb-burger {
            font-size: 17px;
            color: var(--primary);
            flex: none;
            width: 24px;
            text-align: center;
        }


        .sb-title {
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            opacity: 0;
            transform: translateX(-6px);
            transition: opacity .25s, transform var(--ease);
        }


        .sidebar.open .sb-title {
            opacity: 1;
            transform: none;
        }


        .sb-scroll {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 0 24px;
            scrollbar-width: thin;
        }


            .sb-scroll::-webkit-scrollbar {
                width: 4px;
            }


            .sb-scroll::-webkit-scrollbar-thumb {
                background: var(--line);
                border-radius: 4px;
            }


        .sb-section {
            padding: 16px 20px 6px;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: .06em;
            color: var(--ink-3);
            white-space: nowrap;
            opacity: 0;
            transition: opacity .2s;
        }


        .sidebar.open .sb-section {
            opacity: 1;
        }


        .nav-item {
            position: relative;
        }


        .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 9px 20px;
            margin: 2px 8px;
            border-radius: 10px;
            color: var(--ink-2);
            cursor: pointer;
            white-space: nowrap;
            transition: background .2s, color .2s;
        }


            .nav-link:hover {
                background: var(--surface-2);
                color: var(--primary);
            }


            .nav-link i.ic {
                width: 24px;
                flex: none;
                text-align: center;
                font-size: 15px;
            }


        .nav-label {
            flex: 1;
            font-size: 13.5px;
            font-weight: 500;
            opacity: 0;
            transform: translateX(-6px);
            transition: opacity .22s, transform var(--ease);
        }


        .sidebar.open .nav-label {
            opacity: 1;
            transform: none;
        }


        .nav-item.active > .nav-link {
            background: var(--primary-soft);
            color: var(--primary);
            font-weight: 600;
        }


            .nav-item.active > .nav-link::before {
                content: "";
                position: absolute;
                left: -8px;
                top: 8px;
                bottom: 8px;
                width: 3px;
                background: var(--primary);
                border-radius: 0 3px 3px 0;
            }


        /* =========================================================
           DROPDOWNS
        ========================================================== */

        .center-box {
            margin: 6px 12px 0;
            padding: 0 8px;
        }


        .center-select {
            width: 100%;
            padding: 9px 10px;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: var(--surface-2);
            color: var(--ink);
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
            transition: opacity .22s;
        }


        .sidebar.open .center-select {
            opacity: 1;
            pointer-events: auto;
        }


        /* =========================================================
           MAIN
        ========================================================== */

        .main {
            margin-left: var(--sidebar-collapsed);
            padding: 88px 24px 56px;
            transition: margin-left var(--ease);
        }


        body.sb-open .main {
            margin-left: var(--sidebar-w);
        }


        body.sb-open .topbar {
            padding-left: calc(var(--sidebar-w) + 24px);
        }


        /* =========================================================
           STAT CARDS
        ========================================================== */

        .stat-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 22px;
        }


        .stat {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 20px 22px;
            display: flex;
            align-items: flex-start;
            gap: 18px;
            position: relative;
            overflow: hidden;
            transition: transform .2s, box-shadow .2s;
        }


            .stat:hover {
                transform: translateY(-2px);
                box-shadow: 0 2px 4px rgba(22,48,63,.08), 0 14px 32px -14px rgba(22,48,63,.32);
            }


            .stat::after {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: var(--accent,var(--primary));
            }


        .stat-ic {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            flex: none;
            display: grid;
            place-items: center;
            font-size: 19px;
            background: rgba(255,255,255,.15);
            color: #fff;
        }


        .stat-body {
            min-width: 0;
            flex: 1;
        }


        .stat-label {
            font-size: 20px;
            color: #ffffff;
            font-weight: 700;
        }


        .stat-value {
            font-family: 'IBM Plex Serif', Georgia, serif;
            font-weight: 600;
            font-size: 34px;
            line-height: 1.1;
            margin-top: 2px;
            letter-spacing: -.02em;
            color: #ffffff;
        }


        /* =========================================================
           SECTION TITLE
        ========================================================== */

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 32px 0 14px;
            font-size: 16px;
            font-weight: 600;
        }


            .section-title i {
                color: var(--primary);
            }


            .section-title .rule {
                flex: 1;
                height: 1px;
                background: var(--line);
            }


        /* =========================================================
           CARD
        ========================================================== */

        .card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 18px 20px 20px;
            min-width: 0;
        }


        /* =========================================================
           CHARTS
        ========================================================== */

        #chartdiv {
            width: 100%;
            height: 500px;
        }


        #chartdivage {
            width: 100%;
            height: 450px;
        }


        #chart_treatmentpie {
            width: 100%;
            height: 500px;
        }


        #chart_tti {
            width: 100%;
            height: 500px;
        }


        /* =========================================================
           FOOTER
        ========================================================== */

        footer {
            margin-top: 36px;
            padding-top: 18px;
            border-top: 1px solid var(--line);
            color: var(--ink-3);
            font-size: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px 20px;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================== */

        @@media (max-width:1100px) {

            .stat-row {
                grid-template-columns: 1fr;
            }
        }


        @@media (max-width:820px) {

            .stat-row {
                grid-template-columns: 1fr;
            }

            .main {
                padding: 84px 16px 48px;
            }

            .topbar {
                padding: 0 14px 0 calc(var(--sidebar-collapsed) + 14px);
            }

            .brand-text p {
                display: none;
            }

            .stat-value {
                font-size: 30px;
            }

            body.sb-open .main {
                margin-left: var(--sidebar-collapsed);
            }

            body.sb-open .topbar {
                padding-left: calc(var(--sidebar-collapsed) + 14px);
            }
        }
    </style>

</head>


<body>

    <!-- LOADING SCREEN -->
    <div id="pageLoader">
        <img src="~/Models/logo1.png"
             class="loading-logo"
             alt="Hospital Based Cancer Registry" />
    </div>

    <!-- Main Dashboard -->
    <div id="mainPage">
        <!-- Your existing dashboard -->
    </div>

    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar"
           id="sidebar">


        <div class="sb-head">

            <i class="fa-solid fa-bars sb-burger"></i>

            <span class="sb-title">
                Registry Menu
            </span>

        </div>


        <div class="sb-scroll">


            <div class="sb-section">
                Navigation
            </div>


            <!-- DASHBOARD -->
            <div class="nav-item active" id="dashboardNav">

                <div class="nav-link">

                    <i class="fa-solid fa-gauge-high ic"></i>

                    <span class="nav-label">
                        Dashboard
                    </span>

                </div>

            </div>


            <div class="nav-item" id="reportNav">

                <div class="nav-link">

                    <i class="fa-solid fa-file-lines ic"></i>

                    <span class="nav-label">
                        Report
                    </span>

                </div>

            </div>


            <div id="registrySection">

                <div class="sb-section">
                    Center Selection
                </div>


                <div class="nav-item" id="center-row">

                    <div class="nav-link"  style="cursor:default">

                        <i class="fa-solid fa-hospital ic"></i>

                        <span class="nav-label"  id="center-label">

                            Registry

                        </span>

                    </div>

                </div>


                <div class="center-box">

                    <select class="center-select" id="centerSelect">

                        <option value="registry"> Select registry center </option>

                        <option value="mumbai"> Mumbai</option>

                        <option value="varanasi"> Varanasi </option>

                        <option value="vizag"> Vizag </option>

                        <option value="sangrur"> Sangrur </option>

                    </select>

                </div>

            </div>
              
            
            
            <div id="sitesSection">
                <div class="sb-section">
                    Sites
                </div>
                <div class="center-box">
                    <select id="system4Dropdown" class="center-select">
                        <option value="">  All Sites  </option>
                    </select>
                </div>
                <div class="center-box">
                    <select id="System2Dropdown" class="center-select">
                        <option value=""> All Subsites </option>
                    </select>
                </div>
            </div>
          
            <!-- AGE CATEGORY MULTI-SELECT -->
           
            <div class="form-group" id="ageFilter">
                @*<label class="control-label">Age Category</label>*@
                <div class="sb-section">  Age Category </div>

                <select id="ageDropdown" class="center-select"  multiple="multiple" style="width: 100%;">
                    <option value="0 - 19">0 - 19</option>
                    <option value="20 - 45">20 - 45</option>
                    <option value="46 - 59">46 - 59</option>
                    <option value=">=60">>=60</option>
                </select>
            </div>
           
         
              
            
        
        </div>

    </aside>


    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-mark">

                @*<i class="fa-solid fa-ribbon"></i>*@

                <img src="~/Models/tmc logo.png" />
            </div>


            <div class="brand-text">

                <h1> Division of cancer care, hbcr & survival studies </h1>
             
                <h4>Centre For Cancer Epidemiology</h4>

               

            </div>
            <p id="brandSub">  Centre For Cancer Epidemiology </p>

        </div>


        <div class="topbar-right">


            <span class="center-pill">

                <i class="fa-solid fa-location-dot"></i>

                <span id="centerPill"> All Centers</span>

            </span>


            <button class="icon-btn"id="themeBtn" title="Switch light or dark view">

                <i class="fa-solid fa-circle-half-stroke"></i>

            </button>


        </div>

    </header>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="main">


        <!-- =====================================================
             DASHBOARD
        ====================================================== -->

        <section id="sec-dashboard">


            <div class="stat-row">


                <!-- TOTAL -->

                <div class="stat"
                     style="background-color:#578ebe;--accent:#ffffff;">

                    <div class="stat-ic">

                        <i class="fa-solid fa-folder-open"></i>

                    </div>


                    <div class="stat-body">

                        <div class="stat-label">
                            Total registered cases
                        </div>

                        <div class="stat-value" id="statTotal">
                            @ViewBag.TotalCount
                        </div>

                    </div>

                </div>


                <!-- MALE -->

                <div class="stat"
                     style="background-color:#44b6ae;--accent:#ffffff;">

                    <div class="stat-ic">

                        <i class="fa-solid fa-person"></i>

                    </div>


                    <div class="stat-body">

                        <div class="stat-label">
                            Male cases
                        </div>

                        <div class="stat-value" id="statMale">

                            @ViewBag.TotalMaleCount

                        </div>

                    </div>

                </div>


                <!-- FEMALE -->

                <div class="stat"
                     style="background-color:#e35b5a;--accent:#ffffff;">

                    <div class="stat-ic">

                        <i class="fa-solid fa-person-dress"></i>

                    </div>


                    <div class="stat-body">

                        <div class="stat-label">
                            Female cases
                        </div>

                        <div class="stat-value"  id="statFemale">

