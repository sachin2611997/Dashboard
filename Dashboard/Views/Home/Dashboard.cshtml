@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <title>Hospital Based Cancer Registry</title>

    <style>
        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            /*background: white;*/
        }

        #loader {
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            /*background: white;*/
        }

            #loader img {
                width: 500px;
                max-width: 70%;
                animation: pulse 1.5s ease-in-out infinite;
            }



            .video-container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
}

/* Video in background */
.background-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
}

/* Logo above video */
#loader {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
}

/*#loader img {
    max-width: 300px;
    height: auto;
}*/



        @@keyframes pulse {

            0%, 100% {
                opacity: .65;
                transform: scale(.97);
            }

            50% {
                opacity: 1;
                transform: scale(1);
            }
        }
    </style>

</head>

<body>
    <div class="video-container">

        <!-- Background Video -->
        <video autoplay muted loop playsinline class="background-video">
            <source src="~/Models/video_preview_h264.mp4" type="video/mp4" />
        </video>

        <!-- Logo on top of video -->
        <div id="loader">
            <img src="~/Models/logo1.png" alt="Hospital Based Cancer Registry (HBCR)" />
        </div>

    </div>

    <script>

        window.location.href =
            '@Url.Action("Index", "Home")';

    </script>

</body>

</html>