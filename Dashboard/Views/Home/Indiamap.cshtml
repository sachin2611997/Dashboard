    <script src="~/assets/jquery.min.js"></script>
    <script>

                const raw = @Html.Raw(Json.Encode(Model));
                const stateData = {};
                Object.keys(raw).forEach(id => { stateData[id] = { value: raw[id] }; });
                const maxCount = Math.max(1, ...Object.values(raw));

                /* 2️⃣ COLOR SCALE (LIKE IMAGE) = */

                function getColor(count) {
                    //blue
                    //if (count > 30 && count <= 60) return "#1565c0";
                    //if (count >= 101 && count <= 300) return "#1e88e5";
                    //if (count > 10 && count <= 20) return "#64b5f6";
                  //  if (count >= 30 && count <= 100) return "#90caf9";
                    //if (count >= 1 && count <= 2) return "#bbdefb";
                   // if (count >= 0 && count <= 29) return "#e3f2fd";

                    if (!count) return "#ffffff";
                    const r = count / maxCount;
                    if (r > 0.75) return "#64b5f6";
                    if (r > 0.50) return "#90caf9";
                    if (r > 0.25) return "#bbdefb";
                    return "#e3f2fd";
                }
                Object.keys(stateData).forEach(id => {
                    const state = document.getElementById(id);
                    if (!state || state.tagName !== "path") return;   // <-- skip the Mumbai circle
                    state.style.fill = getColor(stateData[id].value);
                });

                /*  3️⃣ APPLY COLOR + TOOLTIP  = */
                Object.keys(stateData).forEach(id => {
                    const state = document.getElementById(id);
                    if (!state) return;

                    const data = stateData[id];
                    state.style.fill = getColor(data.value);

                    const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
                    // title.textContent = `${state.getAttribute("name")} :${data.value}`;
                    state.appendChild(title);
                });

                /*  4️⃣ ADD STATE NAME + COUNT TEXT */

                Object.keys(stateData).forEach(id => {
                    const state = document.getElementById(id);
                    if (!state) return;

                    //state.style.fill = stateData[id].color;
                    state.style.stroke = "#444";
                    state.style.strokeWidth = "1";

                    const bbox = state.getBBox();

                    // Skip very small states (Delhi, Goa, NE)
                    if (bbox.width < 35 || bbox.height < 35) return;

                    const cx = bbox.x + bbox.width / 2;
                    const cy = bbox.y + bbox.height / 2;

                    const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                    text.setAttribute("x", cx);
                    text.setAttribute("y", cy);
                    text.setAttribute("text-anchor", "middle");
                    text.setAttribute("font-size", "12");
                    text.setAttribute("font-weight", "bold");
                    text.setAttribute("fill", "#000");

                    const tspan1 = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
                    tspan1.setAttribute("x", cx);
                    tspan1.setAttribute("dy", "-2");
                    tspan1.textContent = state.getAttribute("name");

                    const tspan2 = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
                    tspan2.setAttribute("x", cx);
                    tspan2.setAttribute("dy", "14");
                    tspan2.textContent = `${stateData[id].value}`;

                    text.appendChild(tspan1);
                    text.appendChild(tspan2);

                    state.parentNode.appendChild(text);
                });

                /*  5️⃣ HOVER: ZOOM STATE + SHOW NAME & COUNT */
                const hoverLayer = document.getElementById("hoverLayer");
                const SVG_NS = "http://www.w3.org/2000/svg";

                document.querySelectorAll("#features path, #INMH_Mumbai").forEach(el => {
                    const data = stateData[el.id];
                    if (!data) return;
                    const isDot = el.tagName === "circle";

                    el.addEventListener("mouseenter", () => {
                        hoverLayer.innerHTML = "";

                        let cx, cy;
                        if (isDot) {
                            cx = +el.getAttribute("cx");
                            cy = +el.getAttribute("cy") - 45;          // label sits above the dot
                        } else {
                            const bbox = el.getBBox();
                            cx = bbox.x + bbox.width / 2;
                            cy = bbox.y + bbox.height / 2;

                            const clone = el.cloneNode(false);          // zoomed copy of the state
                            clone.removeAttribute("id");
                            clone.classList.add("hover-clone");
                            clone.style.fill = getColor(data.value);
                            clone.style.transformOrigin = `${cx}px ${cy}px`;
                            hoverLayer.appendChild(clone);
                        }

                        const name = el.getAttribute("name");
                        const w = Math.max(90, name.length * 8.5 + 20), h = 52;
                        const lx = Math.min(Math.max(cx, w / 2 + 5), 1000 - w / 2 - 5);
                        const ly = Math.min(Math.max(cy, h / 2 + 5), 1000 - h / 2 - 5);

                        const bg = document.createElementNS(SVG_NS, "rect");
                        bg.setAttribute("class", "hover-label-bg");
                        bg.setAttribute("x", lx - w / 2); bg.setAttribute("y", ly - h / 2);
                        bg.setAttribute("width", w);      bg.setAttribute("height", h);

                        const t1 = document.createElementNS(SVG_NS, "text");
                        t1.setAttribute("class", "hover-name");
                        t1.setAttribute("x", lx); t1.setAttribute("y", ly - 6);
                        t1.textContent = name;

                        const t2 = document.createElementNS(SVG_NS, "text");
                        t2.setAttribute("class", "hover-count");
                        t2.setAttribute("x", lx); t2.setAttribute("y", ly + 17);
                        t2.textContent = data.value;

                        hoverLayer.append(bg, t1, t2);
                    });

                    el.addEventListener("mouseleave", () => hoverLayer.innerHTML = "");
                });
    </script>

    <script>
        // Counts already come filtered from the controller (stateData), no second AJAX call needed
        $(function () {
            $("#indiaMap").on("click", "path", function () {
                var id = this.id;
                var name = $(this).attr("name") || $(this).attr("data-name") || id;
                var count = stateData[id] ? stateData[id].value : 0;
                $("#selectedState").text(name);
                $("#selectedCount").text(Number(count).toLocaleString());
            });
        });
    </script>
