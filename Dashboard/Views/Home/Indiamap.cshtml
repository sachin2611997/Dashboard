@model Dictionary<string, int>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>India State Count Map</title>
    <style>
        body {
            background: white;
            margin: 0;
            padding: 0;
        }

        svg {
            width: 100%;
            height: 100vh;
            background: white;
        }

        path {
            stroke: black;
            stroke-width: 2;
            /* drop-shadow filter on every path removed: it made rendering/hover slow */
            cursor: pointer;
            vector-effect: non-scaling-stroke;
            paint-order: stroke fill; /* ✅ stroke drawn first */
        }

        text {
            font-family: Arial, sans-serif;
            pointer-events: none;
            /*font-weight: bold;*/
            font-size: 15px;
        }

        path {
            transition: opacity .15s;
        }

        .hover-clone {
            stroke: #0d47a1;
            stroke-width: 2.5;
            filter: drop-shadow(0 6px 8px rgba(0,0,0,.45));
            animation: pop .18s ease-out forwards;
        }

        @@keyframes pop {
            from {
                transform: scale(1);
            }

            to {
                transform: scale(1.90);
            }
        }

        .hover-label-bg {
            fill: #fff;
            stroke: #0d47a1;
            stroke-width: 1.5;
            rx: 6;
        }

        .hover-name {
            font-size: 15px;
            font-weight: bold;
            fill: #000;
            text-anchor: middle;
        }

        .hover-count {
            font-size: 20px;
            font-weight: bold;
            fill: #0d47a1;
            text-anchor: middle;
        }

        @@media print {
            body {
                margin: 0;
                background: white;
            }

            svg {
                width: 100%;
                height: auto;
                page-break-inside: avoid;
            }
        }

        .map-container {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            width: 100%;
            height: calc(100vh - 130px);
            box-sizing: border-box;
            overflow: hidden;
        }

        .india-map {
            flex: 1;
            min-width: 0;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        #indiaMap {
            width: 100%;
            height: 100%;
            max-height: 100%;
            display: block;
            object-fit: contain;
        }

        /* Right-side state information */
        .state-info-box {
            width: 280px;
            flex-shrink: 0;
            align-self: flex-start;
            background: #ffffff;
            border: 1px solid #e4eaf2;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(35, 65, 110, 0.10);
            font-family: Arial, sans-serif;
        }
        /* Blue heading section */
        .state-info-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px;
            background: linear-gradient(135deg, #24549f, #3980d8);
            color: #ffffff;
        }

        .state-info-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.18);
            border-radius: 10px;
            font-size: 20px;
        }

        .state-info-header h3 {
            margin: 0;
            padding: 0;
            border: none;
            color: #ffffff;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        /* Card content */
        .state-info-content {
            padding: 22px 18px;
        }

        .state-info-box h3 {
            margin: 0 0 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #ffffff;
            /*color: #2f6db4;*/
            font-size: 19px;
        }

        .state-info-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }

            .state-info-row:last-child {
                margin-bottom: 0;
            }

            .state-info-row span {
                color: #78869a;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .state-info-row strong {
                color: #243653;
                font-size: 19px;
                font-weight: 700;
                overflow-wrap: anywhere;
            }
            /* Patient count highlight */
            .state-info-row.count-row {
                padding: 16px;
                background: #f0f5ff;
                border: 1px solid #dce8ff;
                border-radius: 10px;
            }

                .state-info-row.count-row strong {
                    color: #285fb5;
                    font-size: 32px;
                    line-height: 1.2;
                }

                .state-info-row.count-row small {
                    color: #7a8ba5;
                    font-size: 11px;
                }

        #indiaMap path {
            cursor: pointer;
        }

            #indiaMap path:hover {
                opacity: 0.75;
            }

        @@media (max-width: 768px) {
            .map-container {
                flex-direction: column;
            }

            .state-info-box {
                width: 100%;
                box-sizing: border-box;
            }
        }

        /* ===== Filter summary bar (registry / site / sub-site / age) ===== */
        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            padding: 10px 16px;
            font-family: Arial, sans-serif;
            font-size: 13px;
            background: #f5f8fc;
            border-bottom: 1px solid #e4eaf2;
        }

            .filter-bar .chip {
                background: #fff;
                border: 1px solid #dce8ff;
                border-radius: 20px;
                padding: 4px 12px;
                color: #243653;
            }

                .filter-bar .chip b {
                    color: #78869a;
                    font-weight: 600;
                    margin-right: 4px;
                }

                .filter-bar .chip.total {
                    background: #285fb5;
                    border-color: #285fb5;
                    color: #fff;
                    margin-left: auto;
                }

                    .filter-bar .chip.total b {
                        color: #cfe0ff;
                    }

        .legend {
            display: flex;
            gap: 6px;
            align-items: center;
            font: 12px Arial;
            margin-left: 12px;
        }

            .legend i {
                display: inline-block;
                width: 18px;
                height: 12px;
                border: 1px solid #999;
            }
    </style>
</head>
<body>
    <div class="filter-bar">
        <span class="chip"><b>Registry:</b> @ViewBag.CenterLabel</span>
        <span class="chip"><b>Site:</b> @ViewBag.SiteLabel</span>
        <span class="chip"><b>Sub-site:</b> @ViewBag.SubSiteLabel</span>
        <span class="chip"><b>Age:</b> @ViewBag.AgeLabel</span>
        <span class="legend">
            Low
            <i style="background:#e3f2fd"></i><i style="background:#bbdefb"></i><i style="background:#90caf9"></i><i style="background:#64b5f6"></i>
            High
        </span>
        <span class="chip total"><b>Total patients:</b> @ViewBag.Total</span>
    </div>
    <div class="map-container">
        <!-- India SVG Map -->
        <div class="india-map">
